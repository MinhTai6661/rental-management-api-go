# Every setting of the API (config/config.go). Copy what you need into the environment of the process
# (compose environment/env_file, your shell, the orchestrator). The binary NEVER reads a .env file itself, and the dev
# compose stack already sets working defaults, so a .env file is only needed to override them.
#
# REQUIRED = the process refuses to start without it. Everything else has the default shown.

# --- Process -----------------------------------------------------------------------------------------------------
# local | testing | production. In production SMTP_HOST becomes required.
APP_ENV=local
HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# Web origins allowed to call the API from a browser (comma separated, scheme://host[:port], no path, no wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:2001
# Version of the terms of use people must accept; changing it asks everybody to accept again.
TERMS_VERSION=2026-11-03

# --- Postgres ----------------------------------------------------------------------------------------------------
# REQUIRED by `api`, `migrate` and `seed`.
DATABASE_URL=postgres://rental_management:CHANGE_ME@postgres:5432/rental_management_dev?sslmode=disable
DB_MAX_CONNS=10
# Bound every query, lock wait and idle transaction so one slow request cannot pile up the pool.
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --- Redis (revoked tokens and rate limits) ----------------------------------------------------------------------
# REQUIRED by `api`.
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=rental-management:

# --- Tokens ------------------------------------------------------------------------------------------------------
# REQUIRED by `api`: at least 32 bytes of random data, e.g. `openssl rand -base64 48`. Never commit a real one.
JWT_SECRET=
JWT_ISSUER=rental-management
JWT_LEEWAY=5s
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# A refresh token already used is accepted again for this long (two tabs refreshing at once); later it closes the session.
REFRESH_REUSE_GRACE=10s
PERMISSION_CACHE_TTL=60s

# --- Encrypted secrets -------------------------------------------------------------------------------------------
# REQUIRED by `api`, `seed -demo` and the invoice commands: 32 random bytes in base64, e.g. `openssl rand -base64 32`.
# It encrypts the links of bills so the landlord can copy the same link again. Changing or losing it makes the links
# already made unreadable (new ones are made when asked for). The value below is for DEVELOPMENT only (compose uses it).
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Bills -------------------------------------------------------------------------------------------------------
# Days from today to the due date when the landlord gives none, how long the link of a bill works (days), and how many
# days before the due date the reminder goes out.
INVOICE_DUE_DAYS=7
INVOICE_SHARE_TTL_DAYS=90
INVOICE_REMINDER_DAYS=3

# --- Notifications -----------------------------------------------------------------------------------------------
# How many days a notification is kept before `rental-management notifications-prune` (run it daily) deletes it.
NOTIFICATION_RETENTION_DAYS=90

# --- Report conversations (WebSocket: GET /v1/reports/{id}/ws) ----------------------------------------------------
# The largest frame a client may send (bytes), how many frames it may send in a minute, how many sockets one user and one
# report may hold open on one API instance, and how long one write may take. The ticket, the ping and the lifetime of a
# socket are the REALTIME_TICKET_TTL, REALTIME_HEARTBEAT and REALTIME_STREAM_MAX_AGE of the notification stream.
REPORT_WS_MAX_MESSAGE_BYTES=8192
REPORT_WS_MESSAGES_PER_MINUTE=60
REPORT_WS_MAX_SOCKETS_PER_USER=10
REPORT_WS_MAX_SOCKETS_PER_REPORT=10
REPORT_WS_WRITE_TIMEOUT=10s

# --- Payments ----------------------------------------------------------------------------------------------------
# Proof pictures (screenshots of the transfer) of a payment: how many it may carry, how large each may be in KB (the web
# app shrinks them first), and how long the signed link to a picture works (minutes). The pictures are private files
# under payments/ in the media store; their links point at API_PUBLIC_URL (the public origin of this API, no trailing
# slash) and are signed with a key derived from DATA_ENCRYPTION_KEY, so no new secret is needed.
PAYMENT_PROOF_MAX_FILES=3
PAYMENT_PROOF_MAX_SIZE_KB=1024
PAYMENT_PROOF_URL_TTL_MINUTES=120
API_PUBLIC_URL=http://localhost:8090

# --- Invitations -------------------------------------------------------------------------------------------------
# How many days an invitation to rent a room (a link the landlord sends) can be answered (1-90).
INVITATION_TTL_DAYS=7

# --- Email verification ------------------------------------------------------------------------------------------
EMAIL_VERIFICATION_TTL=24h
# Wait between two verification emails to the same address.
EMAIL_RESEND_COOLDOWN=60s

# --- Social login (Google, Zalo) ---------------------------------------------------------------------------------
# A provider is switched on only when both its id and its secret are set; leave them empty to switch it off.
# The redirect URL is the callback of this API, registered with the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8090/v1/auth/google/callback
# ZALO_APP_ID is the numeric App ID of the app at developers.zalo.me.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URL=http://localhost:8090/v1/auth/zalo/callback
# How long a round trip to a provider may take, and the life of the one-time code the web app trades for tokens.
SOCIAL_STATE_TTL=10m
SOCIAL_LOGIN_CODE_TTL=60s

# --- Email -------------------------------------------------------------------------------------------------------
# Links in emails point to the web app.
WEB_URL=http://localhost:2001
# Without SMTP_HOST emails are only written to the log (development only: the log then holds the verification link).
# REQUIRED when APP_ENV=production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Rental Management <no-reply@rental.test>

# --- Pictures ----------------------------------------------------------------------------------------------------
# Where the files of room and building pictures are kept (the compose stack mounts a volume at /data/media).
MEDIA_DIR=var/media
# Absolute prefix of every picture URL in responses (no trailing slash). Must reach GET /v1/media/* of this API.
MEDIA_PUBLIC_BASE_URL=http://localhost:8090/v1/media
# Largest file accepted, in bytes (the web scales and re-encodes pictures first).
MEDIA_MAX_UPLOAD_BYTES=2097152
# Longest side accepted, in pixels.
MEDIA_MAX_DIMENSION=2048
# Longest side of the thumbnail, in pixels.
MEDIA_THUMBNAIL_MAX_SIZE=480
# Pictures per room or building when the plan sets no limit.
MEDIA_MAX_PER_OWNER=10
# Where the picture files live: local (MEDIA_DIR) or s3 (any S3 API: Cloudflare R2, AWS S3, SeaweedFS).
STORAGE_DRIVER=local
# Used (and required) only when STORAGE_DRIVER=s3.
# R2: https://<account>.r2.cloudflarestorage.com (region auto, path style off); SeaweedFS dev: http://seaweedfs:8333.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
# A secret: never commit a real one.
S3_SECRET_ACCESS_KEY=
# auto for R2, us-east-1 for SeaweedFS.
S3_REGION=auto
# true: host/bucket/key (SeaweedFS, MinIO); false: bucket.host/key (R2 and AWS accept both).
S3_PATH_STYLE=true
# With s3, set MEDIA_PUBLIC_BASE_URL to the public address of the bucket (a custom domain in front of R2), or leave it
# on this API's GET /v1/media to serve the pictures through the API.
# Pictures decoded at the same time (each decode uses up to ~16 MB).
IMAGE_PROCESSING_CONCURRENCY=2

# --- Seeding (development only) ----------------------------------------------------------------------------------
# Password of the demo accounts `seed -demo` creates (at least 8 characters); the command refuses to run in production.
SEED_DEMO_PASSWORD=
