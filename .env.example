# Every setting of the API (internal/config/config.go). Copy what you need into the environment of the process
# (compose environment/env_file, your shell, the orchestrator). The binary NEVER reads a .env file itself, and the dev
# compose stack already sets working defaults, so a .env file is only needed to override them.
#
# REQUIRED = the process refuses to start without it. Everything else has the default shown.

# --- Process -----------------------------------------------------------------------------------------------------
# local | testing | production. In production SMTP_HOST becomes required.
APP_ENV=local
HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# Web origins allowed to call the API from a browser (comma separated, scheme://host[:port], no path, no wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:2001
# Version of the terms of use people must accept; changing it asks everybody to accept again.
TERMS_VERSION=2026-11-03

# --- Postgres ----------------------------------------------------------------------------------------------------
# REQUIRED by `api`, `migrate` and `seed`.
DATABASE_URL=postgres://rental_management:CHANGE_ME@postgres:5432/rental_management_dev?sslmode=disable
DB_MAX_CONNS=10
# Bound every query, lock wait and idle transaction so one slow request cannot pile up the pool.
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --- Redis (revoked tokens and rate limits) ----------------------------------------------------------------------
# REQUIRED by `api`.
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=rental-management:

# --- Tokens ------------------------------------------------------------------------------------------------------
# REQUIRED by `api`: at least 32 bytes of random data, e.g. `openssl rand -base64 48`. Never commit a real one.
JWT_SECRET=
JWT_ISSUER=rental-management
JWT_LEEWAY=5s
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# A refresh token already used is accepted again for this long (two tabs refreshing at once); later it closes the session.
REFRESH_REUSE_GRACE=10s
PERMISSION_CACHE_TTL=60s

# --- Email verification ------------------------------------------------------------------------------------------
EMAIL_VERIFICATION_TTL=24h
# Wait between two verification emails to the same address.
EMAIL_RESEND_COOLDOWN=60s

# --- Email -------------------------------------------------------------------------------------------------------
# Links in emails point to the web app.
WEB_URL=http://localhost:2001
# Without SMTP_HOST emails are only written to the log (development only: the log then holds the verification link).
# REQUIRED when APP_ENV=production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Rental Management <no-reply@rental.test>

# --- Seeding (development only) ----------------------------------------------------------------------------------
# Password of the demo accounts `seed -demo` creates (at least 8 characters); the command refuses to run in production.
SEED_DEMO_PASSWORD=
